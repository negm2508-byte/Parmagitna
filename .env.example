# ==============================================================================
# PaperERP Enterprise — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your local development setup
# ==============================================================================

# Application Ports
SERVER_PORT=8080
FRONTEND_PORT=5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=papererp
DB_USER=papererp
DB_PASSWORD=papererp_dev_password

# Spring Profiles (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Security & JWT Configuration
JWT_SECRET=super_secret_enterprise_papererp_jwt_key_must_be_at_least_256_bits_long_12345
JWT_EXPIRATION_MINUTES=60
