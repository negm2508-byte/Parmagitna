# ==============================================================================
# PaperERP Enterprise - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT-SPECIFIC CREDENTIALS
# DO NOT COMMIT THE REAL .env FILE OR REAL CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Reverse Proxy Trust Boundary (Regular expression matching trusted internal proxy IP ranges)
# Example for AWS ALB / Kubernetes internal subnets:
TRUSTED_PROXY_REGEX=10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2[0-9]|3[0-1])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}

# Spring Active Profiles: local, test, or prod
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL / Supabase Database Connection (JDBC)
# In Staging / Production, use the restricted runtime application role (paper_erp_app_role)
# NEVER use postgres or supabase_admin as the runtime application user!
SUPABASE_DB_URL=jdbc:postgresql://<staging-db-host>:5432/<staging-db-name>?sslmode=require
SUPABASE_DB_USERNAME=paper_erp_app_role
SUPABASE_DB_PASSWORD=replace_with_secure_database_password_here

# Connection Pool Settings (HikariCP - PgBouncer compatible)
DB_POOL_MIN_IDLE=10
DB_POOL_MAX_SIZE=50
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_MAX_LIFETIME_MS=1800000

# Flyway Migration Governance
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false

# Distributed Rate Limiting via Redis (Multi-Instance Protection)
REDIS_HOST=<staging-redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password_here
REDIS_SSL_ENABLED=true
REDIS_TIMEOUT_MS=2000
REDIS_CONNECT_TIMEOUT_MS=2000

# Rate Limiter Failure Mode: fail-closed (production safe), in-memory-fallback, or fail-open
RATE_LIMITING_REDIS_FAILURE_MODE=fail-closed

# Security & JWT Authentication
# Must be at least 256 bits (32 bytes) cryptographically secure random base64 string
APP_JWT_SECRET=replace_with_a_base64_encoded_32_byte_cryptographically_secure_random_key_here
APP_JWT_EXPIRATION_MINUTES=15
APP_REFRESH_TOKEN_EXPIRATION_HOURS=8
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax

# CORS Configuration (Comma-separated allowed frontend origins)
APP_CORS_ALLOWED_ORIGINS=https://staging.papererp.example.com

# Documentation & Actuator Endpoints (Disabled by default in production)
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# Logging Level
APP_LOG_LEVEL=INFO
