# ==============================================================================
# PaperERP Enterprise — Root .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment and Secrets (CRITICAL: NEVER COMMIT REAL CREDENTIALS)
.env
.env.local
.env.*.local
*.pem
*.key
*.p12

# Java & Maven Artifacts
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Node & Frontend Artifacts
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor Files
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Database & Docker Local Volumes
pgdata/
*.sqlite
*.db

# Logs & Temporary Files
logs/
*.log
tmp/
temp/
